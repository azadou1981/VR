# LF partout : dans le dépôt ET dans la copie de travail.
# Unity écrit ses YAML en LF ; sans `eol=lf`, Git for Windows les
# rendrait en CRLF à chaque clone (core.eol vaut `native` par défaut).
# On le pose ici plutôt que dans .git/config, qui ne se clone pas.
# Les binaires en LFS portent `-text` plus bas, ils ne sont pas touchés.
* text=auto eol=lf

# ============================================================
#  YAML Unity — reste en TEXTE, pas en LFS
# ============================================================
# Ces fichiers sont du YAML. On les garde en texte pour deux
# raisons : ils se diffent, et UnityYAMLMerge sait les fusionner.
# En LFS, tout conflit sur une scène deviendrait « choisis A ou B »,
# c'est-à-dire une perte de travail garantie.
*.unity               merge=unityyamlmerge
*.prefab              merge=unityyamlmerge
*.asset               merge=unityyamlmerge
*.mat                 merge=unityyamlmerge
*.anim                merge=unityyamlmerge
*.controller          merge=unityyamlmerge
*.overrideController  merge=unityyamlmerge
*.physicMaterial      merge=unityyamlmerge
*.physicsMaterial2D   merge=unityyamlmerge
*.preset              merge=unityyamlmerge
*.lighting            merge=unityyamlmerge
*.scenetemplate       merge=unityyamlmerge
*.mask                merge=unityyamlmerge
*.mixer               merge=unityyamlmerge
*.playable            merge=unityyamlmerge
*.signal              merge=unityyamlmerge
*.guiskin             merge=unityyamlmerge
*.fontsettings        merge=unityyamlmerge
*.flare               merge=unityyamlmerge
*.brush               merge=unityyamlmerge
*.terrainlayer        merge=unityyamlmerge
*.spriteatlas         merge=unityyamlmerge
*.renderTexture       merge=unityyamlmerge
*.shadervariants      merge=unityyamlmerge
*.meta                merge=unityyamlmerge

